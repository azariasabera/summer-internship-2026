#outputs/ # changed to hydra-logs/ in this repo
hydra-logs/
multirun/
.hydra/

# --- DeepFilterNet / model / hub caches (if they ever land in the repo) ---
.cache/
**/DeepFilterNet/
*.ckpt
*.pth
*.pt
*.onnx
*.bin
*.safetensors

# --- Audio / data / experiment artifacts (adjust paths to your repo) ---
*.wav
*.mp3
*.flac
*.mp4
datasets/
checkpoints/
embeddings/
runs/
*.log

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# --- Misc local ---
tempCodeRunnerFile.py