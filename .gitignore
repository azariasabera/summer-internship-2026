*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/
*.egg

# --- Virtual envs / secrets ---
.env
.envrc
.venv/
venv/
env/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Tests / type / lint caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Hydra / OmegaConf ---
